      options: [
        '"20"',
        '"1055"',
        '"155"',
        '155'
      ],
      answerIdx: 2,
      explanation: 'Evaluated left-to-right: `10 + 5` is mathematical addition producing `15`. Then `15 + "5"` triggers string concatenation, producing the string `"155"`.'
    },
    references: [
